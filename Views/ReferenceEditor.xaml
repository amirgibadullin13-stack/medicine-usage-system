<UserControl x:Class="DrugUsageSimple.Views.ReferenceEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}" Margin="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleText"/>

            <ListBox x:Name="RefList" Grid.Row="1" Margin="0,12,0,12" MinHeight="180"
                     DisplayMemberPath="Name" SelectionChanged="RefList_SelectionChanged"/>

            <StackPanel Grid.Row="2">
                <TextBlock x:Name="InputLabel" Style="{StaticResource FormLabel}"/>
                <TextBox x:Name="NameBox" MaxLength="100"/>
            </StackPanel>

            <WrapPanel Grid.Row="3" Margin="0,12,0,0">
                <Button Content="Добавить" Style="{StaticResource PrimaryButton}" Click="Add_Click" Margin="0,0,8,8"/>
                <Button Content="Сохранить изменения" Style="{StaticResource SecondaryButton}" Click="Rename_Click" Margin="0,0,8,8"/>
                <Button Content="Удалить" Style="{StaticResource DangerOutlineButton}" Click="Delete_Click" Margin="0,0,0,8"/>
            </WrapPanel>

            <TextBlock x:Name="StatusText" Grid.Row="4" TextWrapping="Wrap"/>
        </Grid>
    </Border>
</UserControl>
