<Window x:Class="DrugUsageSimple.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Смена пароля"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20" Width="300">
        <TextBlock Text="Текущий пароль"/>
        <PasswordBox x:Name="OldBox" Margin="0,2,0,10"/>

        <TextBlock Text="Новый пароль (не короче 4 символов)"/>
        <PasswordBox x:Name="NewBox" Margin="0,2,0,10"/>

        <TextBlock Text="Повторите новый пароль"/>
        <PasswordBox x:Name="RepeatBox" Margin="0,2,0,10"/>

        <TextBlock x:Name="MessageText" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сохранить" IsDefault="True" Click="Save_Click" Padding="14,4" Margin="0,0,8,0"/>
            <Button Content="Отмена" IsCancel="True" Padding="14,4"/>
        </StackPanel>
    </StackPanel>
</Window>
