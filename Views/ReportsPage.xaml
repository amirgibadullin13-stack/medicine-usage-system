<UserControl x:Class="MedicineUsageSystem.Views.ReportsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Button Content="←  Назад" Style="{StaticResource SecondaryButton}" Click="Back_Click" Margin="0,0,16,0"/>
            <TextBlock Text="Отчёты" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Фильтры -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,20,0,10" Padding="16">
            <WrapPanel>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Период: с" Style="{StaticResource FormLabel}"/>
                    <DatePicker x:Name="FromPicker" Width="160"/>
                </StackPanel>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="по" Style="{StaticResource FormLabel}"/>
                    <DatePicker x:Name="ToPicker" Width="160"/>
                </StackPanel>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Отделение" Style="{StaticResource FormLabel}"/>
                    <ComboBox x:Name="DepartmentBox" Width="200" DisplayMemberPath="Name"/>
                </StackPanel>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Сортировка детального отчёта" Style="{StaticResource FormLabel}"/>
                    <ComboBox x:Name="SortBox" Width="200"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Применить" Style="{StaticResource PrimaryButton}" Click="Apply_Click" Margin="0,0,10,0"/>
                    <Button Content="Сбросить" Style="{StaticResource SecondaryButton}" Click="Reset_Click"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <TextBlock x:Name="FilterSummary" Grid.Row="2" TextWrapping="Wrap" Margin="2,0,0,10"/>

        <TabControl Grid.Row="3">

            <!-- Детальный отчёт -->
            <TabItem Header="Детальный отчёт" Padding="14,8">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="DetailGrid" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ФИО пациента" Binding="{Binding FullName}" Width="2*"
                                                ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Отделение" Binding="{Binding Department}" Width="*"
                                                ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Дата использования" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="160"
                                                ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Препарат" Binding="{Binding Drug}" Width="*"
                                                ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Дозировка" Binding="{Binding Dosage}" Width="120"
                                                ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Кол-во" Binding="{Binding Count}" Width="90"
                                                ElementStyle="{StaticResource CellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <TextBlock x:Name="DetailCount" VerticalAlignment="Center"/>
                        <Button x:Name="ExportDetailBtn" Content="Выгрузить в XLSX" Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Right" Click="ExportDetail_Click"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Общий итог -->
            <TabItem Header="Общий итог" Padding="14,8">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Суммарное использование препаратов за выбранный период. ФИО пациентов не выводятся."
                               Margin="0,0,0,10"/>
                    <DataGrid x:Name="TotalsGrid" Grid.Row="1" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Название препарата" Binding="{Binding Drug}" Width="2*"
                                                ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Суммарное количество за период" Binding="{Binding Total}" Width="*"
                                                ElementStyle="{StaticResource CellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <TextBlock x:Name="TotalsCount" VerticalAlignment="Center"/>
                        <Button x:Name="ExportTotalsBtn" Content="Выгрузить в XLSX" Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Right" Click="ExportTotals_Click"/>
                    </Grid>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
