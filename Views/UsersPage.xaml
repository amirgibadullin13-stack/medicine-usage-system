<UserControl x:Class="MedicineUsageSystem.Views.UsersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Button Content="←  Назад" Style="{StaticResource SecondaryButton}" Click="Back_Click" Margin="0,0,16,0"/>
            <TextBlock Text="Пользователи" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Margin="0,16,0,10" TextWrapping="Wrap"
                   Text="Список логинов и паролей виден только администратору. Выберите пользователя в таблице, чтобы изменить его пароль или удалить его."/>

        <DataGrid x:Name="UsersGrid" Grid.Row="2" AutoGenerateColumns="False"
                  SelectionChanged="Grid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="*"
                                    ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="Пароль" Binding="{Binding Password}" Width="*"
                                    ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="Роль" Binding="{Binding Role}" Width="160"
                                    ElementStyle="{StaticResource CellText}"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,8">
            <StackPanel>
                <WrapPanel>
                    <StackPanel Margin="0,0,16,8">
                        <TextBlock Text="Логин" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="LoginBox" Width="200" MaxLength="30"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,8">
                        <TextBlock Text="Пароль (новый)" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="PassBox" Width="200" MaxLength="50"/>
                    </StackPanel>
                    <CheckBox x:Name="AdminCheck" Content="Администратор" VerticalAlignment="Bottom" Margin="0,0,0,12"/>
                </WrapPanel>
                <WrapPanel>
                    <Button Content="Добавить пользователя" Style="{StaticResource PrimaryButton}"
                            Click="Add_Click" Margin="0,0,10,0"/>
                    <Button Content="Изменить пароль выбранного" Style="{StaticResource SecondaryButton}"
                            Click="ChangePassword_Click" Margin="0,0,10,0"/>
                    <Button Content="Удалить выбранного" Style="{StaticResource DangerOutlineButton}"
                            Click="Delete_Click"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="4" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
