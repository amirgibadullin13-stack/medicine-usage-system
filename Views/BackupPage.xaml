<UserControl x:Class="DrugUsageSimple.Views.BackupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Button Content="←  Назад" Style="{StaticResource SecondaryButton}" Click="Back_Click" Margin="0,0,16,0"/>
            <TextBlock Text="Резервное копирование" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,20,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="900">

                <!-- Сейчас в базе -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Сейчас в базе"/>
                        <TextBlock x:Name="StatsText" Margin="0,8,0,0"/>
                        <TextBlock x:Name="PathText" Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Создать копию -->
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Text="Выгрузить базу данных"/>
                            <TextBlock Text="В файл попадут пациенты, строки использованных препаратов, справочник отделений и справочник препаратов."
                                       TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Создать копию" Style="{StaticResource PrimaryButton}"
                                VerticalAlignment="Center" Click="Create_Click"/>
                    </Grid>
                </Border>

                <!-- Восстановить -->
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Text="Восстановить из файла"/>
                            <TextBlock Text="Выберите ранее выгруженный файл. Программа проверит его структуру и спросит, заменить текущие данные или объединить их с данными из копии."
                                       TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Восстановить…" Style="{StaticResource SecondaryButton}"
                                VerticalAlignment="Center" Click="Restore_Click"/>
                    </Grid>
                </Border>

                <TextBlock x:Name="ResultText" TextWrapping="Wrap" Margin="2,0,0,0"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
