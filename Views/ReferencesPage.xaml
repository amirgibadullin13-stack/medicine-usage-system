<UserControl x:Class="MedicineUsageSystem.Views.ReferencesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:MedicineUsageSystem.Views">
    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Button Content="←  Назад" Style="{StaticResource SecondaryButton}" Click="Back_Click" Margin="0,0,16,0"/>
            <TextBlock Text="Справочники" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <v:ReferenceEditor x:Name="DepartmentsEditor" Margin="0,0,10,0"/>
            <v:ReferenceEditor x:Name="DrugsEditor" Grid.Column="1" Margin="10,0,0,0"/>
        </Grid>
    </Grid>
</UserControl>
