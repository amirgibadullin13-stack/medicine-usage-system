<UserControl x:Class="DrugUsageSimple.Views.PatientEditPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32,24,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <StackPanel Orientation="Horizontal">
            <Button Content="←  Назад" Style="{StaticResource SecondaryButton}" Click="Back_Click" Margin="0,0,16,0"/>
            <TextBlock x:Name="TitleText" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,20,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="980">

                <!-- Данные пациента -->
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,16">
                            <TextBlock Text="ФИО пациента *" Style="{StaticResource FormLabel}"/>
                            <TextBox x:Name="NameBox" MaxLength="150"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,0,8,16">
                            <TextBlock Text="Дата рождения *  (ДД.ММ.ГГГГ)" Style="{StaticResource FormLabel}"/>
                            <DatePicker x:Name="BirthPicker"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,16">
                            <TextBlock Text="Отделение *" Style="{StaticResource FormLabel}"/>
                            <ComboBox x:Name="DepartmentBox" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="0,0,8,0">
                            <TextBlock Text="Дата исполнения *  (ДД.ММ.ГГГГ)" Style="{StaticResource FormLabel}"/>
                            <DatePicker x:Name="ExecPicker"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Препараты -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <TextBlock Text="Использованные препараты" Style="{StaticResource PageTitle}"
                                       VerticalAlignment="Center"/>
                            <Button Content="+  Добавить препарат" Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Right" Click="AddRow_Click"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="38"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Препарат из справочника *" Style="{StaticResource FormLabel}"/>
                            <TextBlock Grid.Column="1" Text="Дозировка *" Style="{StaticResource FormLabel}"/>
                            <TextBlock Grid.Column="2" Text="Дата использования *" Style="{StaticResource FormLabel}"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="38"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox ItemsSource="{Binding DataContext.Drugs, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding Drug, Mode=TwoWay}"
                                                  DisplayMemberPath="Name" Margin="0,0,10,0"/>
                                        <TextBox Grid.Column="1" MaxLength="50"
                                                 Text="{Binding Dosage, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,10,0"/>
                                        <DatePicker Grid.Column="2" SelectedDate="{Binding UsageDate, Mode=TwoWay}"
                                                    Margin="0,0,10,0"/>
                                        <Button Grid.Column="3" Content="✕" Style="{StaticResource IconButton}"
                                                ToolTip="Удалить строку" Click="RemoveRow_Click"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Низ: статус и кнопки -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="DeleteBtn" Content="Удалить пациента" Style="{StaticResource DangerOutlineButton}"
                        Click="Delete_Click" Margin="0,0,10,0" Visibility="Collapsed"/>
                <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" Click="Save_Click" MinWidth="150"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
