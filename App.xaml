<Application x:Class="DrugUsageSimple.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>

        <!-- Цвета: без оформления, только чёрный/серый, красный и зелёный для сообщений -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="Black"/>
        <SolidColorBrush x:Key="DangerBrush" Color="Red"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="Green"/>
        <SolidColorBrush x:Key="BgBrush" Color="White"/>
        <SolidColorBrush x:Key="TextBrush" Color="Black"/>
        <SolidColorBrush x:Key="MutedBrush" Color="Black"/>
        <SolidColorBrush x:Key="BorderBrushLight" Color="Gray"/>

        <!-- Текст -->
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="TileIcon" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
        <Style x:Key="TileTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="TileText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Группа полей: просто рамка -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="BorderBrush" Value="Gray"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Кнопки: стандартные -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Padding" Value="12,4"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Padding" Value="12,4"/>
        </Style>
        <Style x:Key="DangerOutlineButton" TargetType="Button">
            <Setter Property="Padding" Value="12,4"/>
        </Style>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="30"/>
        </Style>
        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="Width" Value="300"/>
            <Setter Property="Height" Value="80"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
        </Style>

        <!-- Таблицы: только поведение, без оформления -->
        <Style TargetType="DataGrid">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>

    </Application.Resources>
</Application>
